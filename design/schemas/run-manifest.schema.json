{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demand-foundry.local/schemas/run-manifest.schema.json",
  "title": "Demand Foundry Run Export Manifest",
  "type": "object",
  "required": [
    "run_id",
    "design_version",
    "generated_at",
    "files"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "design_version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
